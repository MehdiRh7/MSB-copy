# ——— هوش مصنوعی (فقط سمت سرور؛ هرگز در مرورگر قرار نمی‌گیرد) ———
# کافی است کلید یکی از ارائه‌دهنده‌ها را تنظیم کنید؛ انتخاب ارائه‌دهنده فعال
# در «تنظیمات ← هوش مصنوعی» و فقط توسط مدیر سیستم انجام می‌شود.

# Gemini — کلید رایگان از Google AI Studio (aistudio.google.com)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DeepSeek — اتصال مستقیم (platform.deepseek.com)
DEEPSEEK_API_KEY=""

# Grok — اتصال مستقیم (console.x.ai)
XAI_API_KEY=""

# OpenRouter — دروازه مدل‌های رایگان DeepSeek / Grok / Gemini با یک کلید
# (openrouter.ai — مدل‌های دارای پسوند :free)
OPENROUTER_API_KEY=""

# اختیاری: آدرس پایه سفارشی هر ارائه‌دهنده (مثلاً Relay سازمانی)
# GEMINI_BASE_URL=""
# DEEPSEEK_BASE_URL=""
# GROK_BASE_URL=""
# OPENROUTER_BASE_URL=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
